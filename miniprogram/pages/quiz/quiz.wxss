.container {
  padding: 40rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.progress {
  display: flex;
  justify-content: space-between;
  color: #fff;
  font-size: 32rpx;
  margin-bottom: 40rpx;
}

.question-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 40rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.question {
  font-size: 72rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
}

.timer-bar {
  width: 100%;
  height: 20rpx;
  background: #e0e0e0;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.timer-progress {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  transition: width 0.1s linear;
}

.timer-text {
  font-size: 36rpx;
  color: #667eea;
  font-weight: bold;
}

.timer-text.warning {
  color: #ffa502;
}

.timer-text.danger {
  color: #ff6b6b;
}

.input-group {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 48rpx;
  text-align: center;
  box-sizing: border-box;
}

.input.error {
  border-color: #ff6b6b;
  background-color: #fff5f5;
}

.buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  height: 90rpx;
  line-height: 90rpx;
  border: none;
  border-radius: 10rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-secondary {
  background: #f5f5f5;
  color: #333;
}

.feedback {
  text-align: center;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-top: 40rpx;
  font-size: 36rpx;
  font-weight: 600;
  background: #fff;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.feedback.success {
  background: #d4edda;
  color: #155724;
}

.feedback.error {
  background: #f8d7da;
  color: #721c24;
}
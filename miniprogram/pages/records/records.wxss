.container {
  padding: 40rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.filter {
  padding: 16rpx 32rpx;
  border: 2rpx solid #667eea;
  background: #fff;
  color: #667eea;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.filter.active {
  background: #667eea;
  color: #fff;
}

.records {
  max-height: 800rpx;
  overflow-y: auto;
}

.record-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.record-date {
  font-weight: 600;
  color: #333;
  font-size: 32rpx;
}

.record-score {
  font-size: 48rpx;
  font-weight: bold;
  color: #667eea;
}

.record-detail {
  color: #666;
  font-size: 28rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 32rpx;
}

.btn-back {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: #f5f5f5;
  color: #333;
  border: none;
  border-radius: 10rpx;
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 40rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-height: 80%;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 56rpx;
  color: #999;
  line-height: 1;
  padding: 0 20rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  max-height: 600rpx;
}

.record-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 30rpx;
  font-size: 28rpx;
  color: #666;
}

.questions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.question-item {
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 20rpx;
}

.question-item.correct {
  border-left: 8rpx solid #28a745;
}

.question-item.correct-but-mistake {
  border-left: 8rpx solid #ffa502;
  background: #fff8e1;
}

.question-item.incorrect {
  border-left: 8rpx solid #dc3545;
  background: #fff5f5;
  border: 4rpx solid #ff6b6b;
}

.question-text {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.status-label {
  margin-left: 10rpx;
}

.status-label.error {
  color: #dc3545;
  font-weight: 600;
}

.status-label.mistake {
  color: #ffa502;
  font-weight: 600;
}

.question-detail {
  font-size: 24rpx;
  color: #666;
}

.btn-delete {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #ff6b6b;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 30rpx;
}